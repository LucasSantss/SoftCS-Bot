# Únicas quatro variáveis necessárias. O mapeamento de agentes, os chats do
# Telegram e a lista de e-mails com acesso ao painel são configurados no
# próprio painel depois do deploy — fica salvo no Neon, não em env var.

# Neon (Postgres serverless) — connection string do projeto
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Bot do Telegram (criado via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Credencial OAuth2 do Google (console.cloud.google.com/apis/credentials), usada
# só pro login do painel (restrito a e-mails @chatbotmaker.io liberados na aba Acesso)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
