# Únicas duas variáveis necessárias. O mapeamento de agentes e os chats do
# Telegram são configurados em /admin.html depois do deploy — fica salvo no
# Neon, não em env var.

# Neon (Postgres serverless) — connection string do projeto
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Bot do Telegram (criado via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
