# Neon (Postgres serverless) — connection string do projeto
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Bot do Telegram (os grupos/canais de destino são cadastrados em /admin.html,
# não são mais fixos aqui)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# App OAuth2 da SoftCS (Configurações > Aplicações)
SOFTCS_CLIENT_ID=
SOFTCS_CLIENT_SECRET=
SOFTCS_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/oauth-callback

# Opcional: secret enviado pela SoftCS para validar o webhook (se existir esse campo
# na tela de configuração do webhook)
SOFTCS_WEBHOOK_SECRET=

# Senha para acessar /admin.html e a API /api/chats (escolha algo forte e único)
ADMIN_SECRET=
