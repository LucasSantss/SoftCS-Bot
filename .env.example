# O mapeamento de agentes, os canais do Slack e a lista de e-mails com acesso
# ao painel são configurados no próprio painel depois do deploy — fica salvo
# no Neon, não em env var.

# Neon (Postgres serverless) — connection string do projeto
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# App do Slack (api.slack.com/apps > seu app > OAuth & Permissions >
# "Bot User OAuth Token") — passo a passo no README. Opcional se você usar
# só o modo fluxo de trabalho (URL de webhook cadastrada na aba Canais).
SLACK_BOT_TOKEN=xoxb-...

# Credencial OAuth2 do Google (console.cloud.google.com/apis/credentials), usada
# só pro login do painel (restrito a e-mails @chatbotmaker.io liberados na aba Acesso)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Segredo que autentica as chamadas do workflow do GitHub Actions em
# /api/poll-tickets (a SoftCS não tem webhook de ticket, então essa rota é
# chamada periodicamente de fora — precisa do mesmo valor cadastrado como
# secret CRON_SECRET no repositório do GitHub). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Opcional: personal access token do GitHub (fine-grained, escopo só desse
# repositório, permissão "Actions: Read and write") — usado só pra disparar
# os workflows de polling na hora assim que você reconecta a SoftCS, em vez
# de esperar o próximo tick do cron externo. Sem essa variável, a conexão
# continua funcionando normal, só sem esse empurrão.
GITHUB_DISPATCH_TOKEN=

# Opcional: chave que autoriza outra plataforma (ex: Metricas-CS) a ler a
# exportação de tickets em /api/export-tickets, servidor-a-servidor, com
# `Authorization: Bearer <chave>`. Sem essa variável, o endpoint recusa tudo
# (401). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXPORT_API_KEY=

# Segredo de assinatura do webhook REAL de clientes/tickets da SoftCS (aba
# Aplicação > Webhooks no painel deles — botão "Revelar" ou "Rotacionar" em
# "Segredo de assinatura"). Formato whsec_xxxxx, copie exatamente como a
# SoftCS mostra (não gerar aqui — é ela quem define). Sem essa variável,
# /api/webhook recusa qualquer evento (500) em vez de aceitar sem validar.
SOFTCS_WEBHOOK_SECRET=

# ─── Dev local (npm run dev) ──────────────────────────────────────────────
# Só pro .env da sua máquina — NÃO cadastrar na Vercel.
#
# No dev local, DATABASE_URL acima deve ser a connection string de uma
# BRANCH do Neon (Neon > Branches > Create branch), nunca a da produção —
# rode o sql/schema.sql nessa branch.
#
# Connection string da PRODUÇÃO, só pra ler o token da SoftCS (somente
# leitura — o local nunca renova o token, senão invalidaria o da produção).
SOFTCS_TOKEN_DATABASE_URL=
#
# E-mail que entra no painel local sem passar pelo Google (precisa ser o
# master ou estar na aba Acesso). Abrir http://localhost:3000 já loga.
DEV_LOGIN_EMAIL=
